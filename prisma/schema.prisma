generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Recurrence {
  NONE
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ExpenseType {
  FIXED       // Gasto fijo (alquiler, suscripciones)
  VARIABLE    // Gasto variable (compras, ocio)
  DEBT        // Deuda / préstamo
  DONATION    // Donación
  INVESTMENT  // Inversión
  SAVINGS     // Ahorro
  OTHER       // Otro
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  monthlyBudget Float?
  avatar        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  incomes       Income[]
  categories    Category[]
  savingsGoals  SavingsGoal[]
  investments   Investment[]
}

/// Categoría de gasto (alimentación, transporte, ocio…)
model Category {
  id        String    @id @default(uuid())
  name      String
  icon      String    @default("📦")
  color     String    @default("#6366F1")
  budget    Float?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@unique([name, userId])
}

/// Meta de ahorro con importe objetivo y fecha opcional
model SavingsGoal {
  id           String    @id @default(uuid())
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  deadline     DateTime?
  emoji        String    @default("🎯")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Agrupa gastos. Nombre libre (ej: "Nómina", "Gastos del hogar").
model Account {
  id        String    @id @default(uuid())
  name      String
  budget    Float?    // Presupuesto mensual opcional
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  incomes   Income[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Ingreso opcionalmente ligado a una cuenta.
model Income {
  id         String     @id @default(uuid())
  name       String
  amount     Float
  recurrence Recurrence @default(NONE)
  isPaid     Boolean    @default(false)
  notes      String?
  month      Int        // 1-12
  year       Int
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// Gasto perteneciente a una cuenta, opcionalmente categorizado.
model Expense {
  id         String     @id @default(uuid())
  name       String
  amount     Float
  recurrence Recurrence @default(NONE)
  isPaid     Boolean    @default(false)
  notes      String?
  month      Int        // 1-12
  year       Int
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenseType ExpenseType @default(VARIABLE)
  cuotaNumber  Int?       // Número de cuota (1, 2, 3…). Se incrementa al propagar.
  totalCuotas  Int?       // Total de cuotas (ej: 12). Se muestra "Cuota 3 de 12".
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Inversión de valor variable (plan de pensiones, fondo…). El valor se actualiza a mano.
model Investment {
  id              String                   @id @default(uuid())
  name            String
  emoji           String                   @default("📈")
  isin            String?
  annualLimit     Float? // Límite de aportación anual (ej. 1500 € en planes de pensiones)
  baseContributed Float                    @default(0) // Aportado antes de empezar a registrar en la app
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuations      InvestmentValuation[]
  contributions   InvestmentContribution[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

/// Valor de una inversión en una fecha. Uno por día.
model InvestmentValuation {
  id           String     @id @default(uuid())
  value        Float
  date         DateTime   @db.Date
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([investmentId, date])
}

/// Aportación de dinero a una inversión.
model InvestmentContribution {
  id           String     @id @default(uuid())
  amount       Float
  date         DateTime   @db.Date
  notes        String?
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([investmentId, date])
}
