generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Recurrence {
  NONE
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum ExpenseType {
  FIXED       // Gasto fijo (alquiler, suscripciones)
  VARIABLE    // Gasto variable (compras, ocio)
  DEBT        // Deuda / préstamo
  DONATION    // Donación
  INVESTMENT  // Inversión
  SAVINGS     // Ahorro
  OTHER       // Otro
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  monthlyBudget Float?        // Presupuesto mensual global de gastos
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  incomes       Income[]
  categories    Category[]
  savingsGoals  SavingsGoal[]
}

/// Categoría de gasto (alimentación, transporte, ocio…)
model Category {
  id        String    @id @default(uuid())
  name      String
  icon      String    @default("📦")
  color     String    @default("#6366F1")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@unique([name, userId])
}

/// Meta de ahorro con importe objetivo y fecha opcional
model SavingsGoal {
  id           String    @id @default(uuid())
  name         String
  targetAmount Float
  savedAmount  Float     @default(0)
  deadline     DateTime?
  emoji        String    @default("🎯")
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Agrupa gastos. Nombre libre (ej: "Nómina", "Gastos del hogar").
model Account {
  id        String    @id @default(uuid())
  name      String
  budget    Float?    // Presupuesto mensual opcional
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Ingreso suelto, sin cuenta. El check se renueva cada ciclo.
model Income {
  id         String     @id @default(uuid())
  name       String
  amount     Float
  recurrence Recurrence @default(NONE)
  isPaid     Boolean    @default(false)
  notes      String?
  month      Int        // 1-12
  year       Int
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

/// Gasto perteneciente a una cuenta, opcionalmente categorizado.
model Expense {
  id         String     @id @default(uuid())
  name       String
  amount     Float
  recurrence Recurrence @default(NONE)
  isPaid     Boolean    @default(false)
  notes      String?
  month      Int        // 1-12
  year       Int
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenseType ExpenseType @default(VARIABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}
